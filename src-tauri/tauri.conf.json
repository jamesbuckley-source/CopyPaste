{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CopyPaste",
  "version": "0.13.49",
  "identifier": "com.copypaste.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CopyPaste",
        "width": 880,
        "height": 620,
        "minWidth": 560,
        "minHeight": 380,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://media.localhost https://*.giphy.com; media-src 'self' blob: http://media.localhost https://*.giphy.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5174"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3REVERjlGNEQzNkNEMzIKUldReXpUWk5uOS9lcDArdlYvQkxHdTlld1gvelU1WUpYYWNVcXFTTTJ1cHRVU2NadzZldzEvSTIK",
      "endpoints": [
        "https://github.com/jamesbuckley-source/CopyPaste/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "shortDescription": "Clipboard history stored locally on your machine",
    "longDescription": "CopyPaste keeps a searchable history of everything you copy - text, images and file lists - on your own machine. Clip contents are stored locally in a SQLite database.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
